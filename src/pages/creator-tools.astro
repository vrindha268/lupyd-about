---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Creator Tools - Lupyd" description="Empower your creative journey with Lupyd's comprehensive suite of tools designed for content creators.">
  <div class="container mx-auto px-4 py-16 md:py-24 lg:py-32 max-w-7xl relative z-10">
    <!-- Page Header -->
    <div class="flex flex-col items-center space-y-4 text-center mb-16 animate-card">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Creator Tools</h1>
      <p class="mx-auto max-w-[700px] text-lg md:text-xl text-muted-foreground leading-relaxed">
        Empower your creative journey with Lupyd's comprehensive suite of tools designed for content creators.
      </p>
    </div>

    <!-- Core Features Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
      <!-- Card 1 -->
      <div class="animate-card" style="animation-delay: 0.05s">
        <div class="bg-card/40 border border-border/50 rounded-lg p-8 flex flex-col items-center text-center h-full shadow-sm hover:shadow-md transition-all duration-300">
          <div class="p-3 bg-primary/10 rounded-full text-foreground mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <h2 class="text-xl font-bold mb-3">Monetization</h2>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">
            Unlock opportunities for monetization on the platform. Turn your passion into income with our creator-friendly monetization tools.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="animate-card" style="animation-delay: 0.1s">
        <div class="bg-card/40 border border-border/50 rounded-lg p-8 flex flex-col items-center text-center h-full shadow-sm hover:shadow-md transition-all duration-300">
          <div class="p-3 bg-primary/10 rounded-full text-foreground mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          </div>
          <h2 class="text-xl font-bold mb-3">Analytics</h2>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">
            Utilize an advanced analytics dashboard to track your content's performance. Gain insights to optimize your strategy and grow your audience.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="animate-card" style="animation-delay: 0.15s">
        <div class="bg-card/40 border border-border/50 rounded-lg p-8 flex flex-col items-center text-center h-full shadow-sm hover:shadow-md transition-all duration-300">
          <div class="p-3 bg-primary/10 rounded-full text-foreground mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
          </div>
          <h2 class="text-xl font-bold mb-3">Tracking</h2>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">
            Monitor your content's performance and audience engagement metrics. Understand what resonates with your audience to create more impactful content.
          </p>
        </div>
      </div>
    </div>

    <!-- Content Creation Suite Section -->
    <section class="mb-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="animate-card" style="animation-delay: 0.05s">
          <h2 class="text-3xl font-bold mb-4">Content Creation Suite</h2>
          <p class="text-muted-foreground mb-6 leading-relaxed">
            Our comprehensive content creation tools help you produce high-quality content that stands out. From ideation to publication, we support your creative process.
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Simple uploading features</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Content inspiration resources</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Collaboration features for team projects</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">AI-powered content suggestions and improvements</span>
            </li>
          </ul>
        </div>
        <div class="animate-card" style="animation-delay: 0.1s">
          <div class="bg-muted/30 border border-border/20 p-4 rounded-lg flex items-center justify-center">
            <img
              src="/CMC.webp"
              alt="Content creation tools"
              class="rounded-lg shadow-md max-w-full h-auto object-cover border border-border/40"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Creator Tools Grid -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold mb-8 text-center animate-card">Creator Tools</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="animate-card" style="animation-delay: 0.05s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 14.7255 3.09032 17.1962 4.85857 19C5.3642 19.5056 5.61702 19.7584 5.61702 20.0898C5.61702 20.2198 5.56846 20.3452 5.48007 20.4435C5.22851 20.7233 4.70425 20.8931 4.23788 20.9427C3.59388 21.0112 3 21.5056 3 22.1538C3 22.3686 3.17889 22.535 3.39178 22.5022C4.16104 22.3837 5.21312 22 6 22H12Z"></path><circle cx="7.5" cy="10.5" r="1.5"></circle><circle cx="11.5" cy="7.5" r="1.5"></circle><circle cx="16.5" cy="9.5" r="1.5"></circle></svg>
              Design Tools
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Create stunning visuals with our intuitive design tools. Access templates, graphics, and editing features to make your content visually appealing.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.1s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
              Video Creation
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Create high quality videos and increase your engagement with the right audience.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.15s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              Content Calendar
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Plan and schedule your content with our content calendar. Stay organized and maintain a consistent posting schedule to grow your audience.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.2s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-3 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
              Performance Analytics
            </h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Gain deep insights into your content performance with detailed analytics. Track engagement, reach, and conversion metrics to refine your strategy.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Monetization Options -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold mb-8 text-center animate-card">Monetization Options</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="animate-card" style="animation-delay: 0.05s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors h-full">
            <h3 class="text-lg font-semibold mb-2">Creator Fund <span class="text-xs px-2 py-0.5 bg-primary/10 text-primary rounded-full font-normal">soon</span></h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Access our Creator Fund to receive financial support based on your content performance and audience engagement. Reward your creativity and hard work.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.1s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors h-full">
            <h3 class="text-lg font-semibold mb-2">Subscription Model</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Offer premium content to subscribers who pay a monthly fee. Build a steady income stream while providing exclusive value to your most dedicated followers.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.15s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors h-full">
            <h3 class="text-lg font-semibold mb-2">Brand Partnerships</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Connect with brands for sponsored content opportunities. Our platform makes it easy to find and collaborate with brands that align with your values.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Back Home Link -->
    <div class="flex justify-center animate-card">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring bg-primary text-primary-foreground shadow hover:bg-primary/90 h-10 px-6 py-2"
      >
        Back to Home
      </a>
    </div>
  </div>
</Layout>
