---
import Layout from "../layouts/Layout.astro";
---

<Layout title="User Experience - Lupyd" description="Discover how Lupyd delivers an exceptional user experience through intuitive design and seamless functionality.">
  <div class="container mx-auto px-4 py-16 md:py-24 lg:py-32 max-w-7xl relative z-10">
    <!-- Page Header -->
    <div class="flex flex-col items-center space-y-4 text-center mb-16 animate-card">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">User Experience</h1>
      <p class="mx-auto max-w-[700px] text-lg md:text-xl text-muted-foreground leading-relaxed">
        Discover how Lupyd delivers an exceptional user experience through intuitive design and seamless functionality.
      </p>
    </div>

    <!-- Experience Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
      <!-- Card 1 -->
      <div class="animate-card" style="animation-delay: 0.05s">
        <div class="bg-card/40 border border-border/50 rounded-lg p-8 flex flex-col items-center text-center h-full shadow-sm hover:shadow-md transition-all duration-300">
          <div class="p-3 bg-primary/10 rounded-full text-foreground mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <h2 class="text-xl font-bold mb-3">Intuitive Interface</h2>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">
            Navigate with ease using our intuitive, minimalist interface design. Our platform is designed to be user-friendly and accessible to everyone.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="animate-card" style="animation-delay: 0.1s">
        <div class="bg-card/40 border border-border/50 rounded-lg p-8 flex flex-col items-center text-center h-full shadow-sm hover:shadow-md transition-all duration-300">
          <div class="p-3 bg-primary/10 rounded-full text-foreground mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
          </div>
          <h2 class="text-xl font-bold mb-3">Seamless Integration</h2>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">
            Experience seamless mobile and desktop integration for on-the-go access. Stay connected across all your devices with synchronized content and notifications.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="animate-card" style="animation-delay: 0.15s">
        <div class="bg-card/40 border border-border/50 rounded-lg p-8 flex flex-col items-center text-center h-full shadow-sm hover:shadow-md transition-all duration-300">
          <div class="p-3 bg-primary/10 rounded-full text-foreground mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <h2 class="text-xl font-bold mb-3">Instant Loading</h2>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">
            Enjoy instant content loading for a smooth and responsive experience. Our platform is optimized for speed, ensuring you never have to wait.
          </p>
        </div>
      </div>
    </div>

    <!-- Designed for Everyone Section -->
    <section class="mb-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="animate-card" style="animation-delay: 0.05s">
          <h2 class="text-3xl font-bold mb-4">Designed for Everyone</h2>
          <p class="text-muted-foreground mb-6 leading-relaxed">
            Our platform is designed with accessibility in mind, ensuring that everyone can enjoy a seamless social networking experience regardless of their abilities or technical expertise.
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Accessibility features built in</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Customizable text sizes and contrast settings</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Voice commands and screen reader compatibility</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Simplified navigation for all users</span>
            </li>
          </ul>
        </div>
        <div class="animate-card" style="animation-delay: 0.1s">
          <div class="bg-muted/30 border border-border/20 p-4 rounded-lg flex items-center justify-center">
            <img
              src="/DD22.webp"
              alt="User interface example"
              class="rounded-lg shadow-md max-w-full h-auto object-cover border border-border/40"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Personalized Experience -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold mb-8 text-center animate-card">Personalized Experience</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="animate-card" style="animation-delay: 0.05s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-2">Custom Themes <span class="text-xs px-2 py-0.5 bg-primary/10 text-primary rounded-full font-normal">soon</span></h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Personalize your experience with custom themes and layouts. Choose from a variety of color schemes and design options to make the platform your own.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.1s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-2">Content Preferences</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Set your content preferences to see more of what you love. Our AI-powered algorithms learn from your interactions to deliver a personalized feed.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.15s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-2">Notification Controls</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Take control of your notifications to stay informed without feeling overwhelmed. Customize when and how you receive alerts about activity on the platform.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.2s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-2">Language Settings</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Use the platform in your preferred language. We support multiple languages to ensure a comfortable experience for users around the world.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Back Home Link -->
    <div class="flex justify-center animate-card">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring bg-primary text-primary-foreground shadow hover:bg-primary/90 h-10 px-6 py-2"
      >
        Back to Home
      </a>
    </div>
  </div>
</Layout>
