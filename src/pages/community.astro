---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Community & Connections - Lupyd" description="Build meaningful relationships and connect with like-minded individuals on Lupyd's community-focused platform.">
  <div class="container mx-auto px-4 py-16 md:py-24 lg:py-32 max-w-7xl relative z-10">
    <!-- Page Header -->
    <div class="flex flex-col items-center space-y-4 text-center mb-16 animate-card">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Community & Connections</h1>
      <p class="mx-auto max-w-[700px] text-lg md:text-xl text-muted-foreground leading-relaxed">
        Build meaningful relationships and connect with like-minded individuals on Lupyd's community-focused platform.
      </p>
    </div>

    <!-- Community Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
      <!-- Card 1 -->
      <div class="animate-card" style="animation-delay: 0.05s">
        <div class="bg-card/40 border border-border/50 rounded-lg p-8 flex flex-col items-center text-center h-full shadow-sm hover:shadow-md transition-all duration-300">
          <div class="p-3 bg-primary/10 rounded-full text-foreground mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
          </div>
          <h2 class="text-xl font-bold mb-3">Smart Friend Discovery</h2>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">
            Connect with like-minded individuals using our smart friend discovery algorithms. Find people who share your interests and passions.
          </p>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="animate-card" style="animation-delay: 0.1s">
        <div class="bg-card/40 border border-border/50 rounded-lg p-8 flex flex-col items-center text-center h-full shadow-sm hover:shadow-md transition-all duration-300">
          <div class="p-3 bg-primary/10 rounded-full text-foreground mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h2 class="text-xl font-bold mb-3">Interest-Based Groups</h2>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">
            Join interest-based community groups to share your passions. Engage in discussions, share content, and build connections around shared interests.
          </p>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="animate-card" style="animation-delay: 0.15s">
        <div class="bg-card/40 border border-border/50 rounded-lg p-8 flex flex-col items-center text-center h-full shadow-sm hover:shadow-md transition-all duration-300">
          <div class="p-3 bg-primary/10 rounded-full text-foreground mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"><rect x="16" y="16" width="6" height="6" rx="1"></rect><rect x="2" y="16" width="6" height="6" rx="1"></rect><rect x="9" y="2" width="6" height="6" rx="1"></rect><path d="M12 8v8M12 16H5v2M12 16h7v2"></path></svg>
          </div>
          <h2 class="text-xl font-bold mb-3">Professional Networking</h2>
          <p class="text-sm text-muted-foreground leading-relaxed flex-1">
            Manage both professional and personal networks with ease. Build your professional presence while maintaining separate personal connections.
          </p>
        </div>
      </div>
    </div>

    <!-- Meaningful Connections Section -->
    <section class="mb-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="animate-card" style="animation-delay: 0.05s">
          <div class="bg-muted/30 border border-border/20 p-4 rounded-lg flex items-center justify-center">
            <img
              src="/BM.webp"
              alt="Community interaction"
              class="rounded-lg shadow-md max-w-full h-auto object-cover border border-border/40"
            />
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.1s">
          <h2 class="text-3xl font-bold mb-4">Building Meaningful Connections</h2>
          <p class="text-muted-foreground mb-6 leading-relaxed">
            Lupyd is designed to foster genuine connections between users. Our platform encourages meaningful interactions rather than superficial engagement.
          </p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Quality conversations over quantity of connections</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Tools to maintain long-term relationships</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Engagement-focused rather than metrics-focused</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-primary font-bold">✓</span>
              <span class="text-sm text-muted-foreground">Community guidelines that promote respect and authenticity</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Community Features -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold mb-8 text-center animate-card">Community Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="animate-card" style="animation-delay: 0.05s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-2">Community Events</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Discover and participate in virtual and in-person events organized by communities. Connect with others who share your interests in real-time.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.1s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-2">Collaborative Projects</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Work together on collaborative projects within your communities. Share ideas, contribute content, and achieve goals as a team.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.15s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-2">Community Challenges</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Participate in community challenges to engage with others and showcase your skills. Challenges provide a fun way to connect and compete.
            </p>
          </div>
        </div>
        <div class="animate-card" style="animation-delay: 0.2s">
          <div class="bg-muted/40 border border-border/20 rounded-lg p-6 hover:bg-muted/60 transition-colors">
            <h3 class="text-lg font-semibold mb-2">Global Communities</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Connect with communities around the world. Expand your horizons by engaging with diverse perspectives and cultures.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Back Home Link -->
    <div class="flex justify-center animate-card">
      <a
        href="/"
        class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring bg-primary text-primary-foreground shadow hover:bg-primary/90 h-10 px-6 py-2"
      >
        Back to Home
      </a>
    </div>
  </div>
</Layout>
